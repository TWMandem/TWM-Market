{
  "name": "twm-market",
  "private": true,
  "version": "0.15.0",
  "description": "TWM Market — неофициальная торговая площадка игроков Amazing Online (настольное приложение для Windows)",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm --filter @twm/shared build",
    "dev:api": "pnpm --filter @twm/api dev",
    "dev:desktop": "pnpm --filter @twm/desktop tauri dev",
    "dev:ui": "pnpm --filter @twm/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
