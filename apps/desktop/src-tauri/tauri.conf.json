{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TWM Market",
  "version": "0.6.0",
  "identifier": "com.twmmarket.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TWM Market",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0E1014"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: http://localhost:3000",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:3000",
        "media-src": "'self' blob: https: http://localhost:3000"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "TWM Market",
    "shortDescription": "Торговая площадка игроков Amazing Online",
    "category": "Utility",
    "copyright": "© 2026 TWM Market contributors. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
