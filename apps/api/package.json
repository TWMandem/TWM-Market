{
  "name": "@twm/api",
  "version": "0.3.0",
  "private": true,
  "description": "Сервер TWM Market: API для настольного приложения",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "admin:reset-2fa": "tsx --env-file-if-exists=.env src/cli/reset-2fa.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@twm/shared": "workspace:*",
    "fastify": "^5.4.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
