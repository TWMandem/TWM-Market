# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# Файл .env в репозиторий не попадает.

# Порт и адрес, на которых слушает сервер
PORT=3000
HOST=0.0.0.0

# development | production | test
NODE_ENV=development

# База данных. Для разработки поднимите её командой: docker compose up -d
DATABASE_URL=postgres://twm:twm@localhost:5432/twm

# Секреты: длинные случайные строки, на каждом сервере свои.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=замените-на-случайную-строку-не-короче-32-символов
CODE_SECRET=замените-на-другую-случайную-строку-не-короче-32-символов

# Сколько живут токены
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# console — письма выводятся в журнал сервера (для разработки)
MAIL_TRANSPORT=console

# Ограничение частоты запросов к входу и регистрации
RATE_LIMIT=true

# true, если сервер стоит за обратным прокси (nginx, Caddy, хостинг)
TRUST_PROXY=false

# Откуда разрешены запросы (через запятую).
# Приложение Tauri на Windows работает с адреса http://tauri.localhost,
# при разработке интерфейс открыт на http://localhost:1420.
CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:1420
