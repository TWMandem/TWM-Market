# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# Файл .env в репозиторий не попадает.

# Порт и адрес, на которых слушает сервер
PORT=3000
HOST=0.0.0.0

# development | production | test
NODE_ENV=development

# Откуда разрешены запросы (через запятую).
# Приложение Tauri на Windows работает с адреса http://tauri.localhost,
# при разработке интерфейс открыт на http://localhost:1420.
CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:1420
